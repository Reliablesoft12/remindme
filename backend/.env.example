# Supabase
SUPABASE_URL=https://ekmuocciihhpiqtcztwi.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_secret_key_here

# AI Provider: 'gemini' or 'openai' (will fallback to other if primary fails)
AI_PROVIDER=gemini

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (optional — used as fallback or primary based on AI_PROVIDER)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# AiSensy WhatsApp
AISENSY_API_KEY=your_aisensy_api_key_here
AISENSY_CAMPAIGN_NAME=your_campaign_name_here

# Microsoft Outlook SMTP
OUTLOOK_EMAIL=your@outlook.com
OUTLOOK_PASSWORD=your_password_or_app_password

# Security
CRON_SECRET=your_random_secret_here

PORT=3001
