# RemindMe Backend Environment Variables
# Copy this file to .env and fill in your values

# AiSensy WhatsApp API
AISENSY_API_KEY=your_aisensy_api_key_here
AISENSY_CAMPAIGN_NAME=your_campaign_name_here

# Microsoft Outlook (365) SMTP
OUTLOOK_EMAIL=your@outlook.com
OUTLOOK_PASSWORD=your_password_or_app_password

# Google Gemini AI (free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Security (make up any random string)
CRON_SECRET=your_random_secret_here

# Server port (optional, defaults to 3001)
PORT=3001
